
rules_version = '2';

// Last Sync: 2024-05-25 08:30 PM (Fix for new account 'get denied' and batch creation)
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users can read any profile, but only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings are public to read, but only owners can create/update.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // Conversations logic
    match /conversations/{conversationId} {
      // Helper to check membership
      function isMember(data) {
        return data != null && data.participantUids != null && request.auth.uid in data.participantUids;
      }

      // Allow 'get' if:
      // 1. The user's UID is in the ID string (allows existence check for new chats)
      // 2. OR the document doesn't exist yet (resource == null)
      // 3. OR the user is a participant in the existing data
      allow get: if isSignedIn() && (
        (conversationId.matches('.*' + request.auth.uid + '.*')) ||
        (resource == null) ||
        isMember(resource.data)
      );
      
      allow list: if isSignedIn() && isMember(resource.data);

      allow create: if isSignedIn() && isMember(request.resource.data);

      allow update: if isSignedIn() && (
        isMember(resource.data) || 
        isMember(request.resource.data)
      );
      
      allow delete: if isSignedIn() && isMember(resource.data);

      // Messages subcollection
      match /messages/{messageId} {
        // Membership check for messages
        // We use getAfter for 'create' to support batches that create the parent conversation
        function canAccessParent() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId));
          return convo != null && isMember(convo.data);
        }

        function canAccessParentAfter() {
          let convo = getAfter(/databases/$(database)/documents/conversations/$(conversationId));
          return convo != null && isMember(convo.data);
        }
        
        allow read: if isSignedIn() && canAccessParent();
        allow create: if isSignedIn() && canAccessParentAfter() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
