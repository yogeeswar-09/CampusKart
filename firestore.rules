
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any public user profile.
    // They can only create and update their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }

    // Listings can be read by any authenticated user.
    // Users can only create, update, or delete their own listings.
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if request.auth.uid == resource.data.sellerId;
    }

    // A user can create a conversation if their UID is part of the conversationId document name.
    // This allows creating the conversation and the first message in a single transaction without a 'get'.
    // Existing conversations can be read/updated only by participants listed in the document.
    match /conversations/{conversationId} {
      allow create: if request.auth != null && (
        (request.auth.uid in conversationId.split('_') && request.auth.uid in request.resource.data.participantUids) ||
        (request.auth.uid in request.resource.data.participantUids)
      );
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participantUids;
    }

    // Messages can be read by participants of the conversation.
    // Messages can only be created by the sender, who must also be a participant.
    match /conversations/{conversationId}/messages/{messageId} {
        // Verify the user is a participant. 
        // We first try the optimized ID check, then fall back to checking the parent conversation document.
        allow read: if request.auth != null && (
          request.auth.uid in conversationId.split('_') ||
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids
        );
        
        // Verify the sender is the authenticated user and a participant.
        allow create: if request.auth != null && (
          (request.resource.data.senderId == request.auth.uid && request.auth.uid in conversationId.split('_')) ||
          (request.resource.data.senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids)
        );
    }
  }
}
