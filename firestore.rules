
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if a user is a participant of a specific conversation
    function isConversationMember(convoId) {
      let convo = get(/databases/$(database)/documents/conversations/$(convoId));
      return isSignedIn() && (
        (request.auth.uid in convoId.split('_')) || 
        (convo != null && request.auth.uid in convo.data.participantUids)
      );
    }

    // Users can read any public user profile.
    // They can only create and update their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings can be read by any authenticated user.
    // Users can only create, update, or delete their own listings.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // A user can create/read a conversation if they are a participant.
    match /conversations/{conversationId} {
      // Allow creation if the user is in the participant list or the ID reflects their UID
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participantUids ||
        request.auth.uid in conversationId.split('_')
      );
      
      // Allow read/update if the user is a participant
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid in conversationId.split('_') ||
        request.auth.uid in resource.data.participantUids
      );

      // Messages subcollection
      match /messages/{messageId} {
        // Use the robust helper to verify membership for reading or listing messages
        allow read: if isConversationMember(conversationId);
        
        // Allow creating messages if the user is the sender and a participant.
        allow create: if isConversationMember(conversationId) && 
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
