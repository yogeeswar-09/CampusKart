
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(conversationId, data) {
      return isSignedIn() && (
        (request.auth.uid in conversationId.split('_')) || 
        (data != null && data.keys().contains('participantUids') && request.auth.uid in data.participantUids)
      );
    }

    // Users can read any public user profile.
    // They can only create and update their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings can be read by any authenticated user.
    // Users can only create, update, or delete their own listings.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // A user can create/read a conversation if they are a participant.
    match /conversations/{conversationId} {
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantUids;
      
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid in conversationId.split('_') ||
        request.auth.uid in resource.data.participantUids
      );

      // Messages subcollection
      match /messages/{messageId} {
        // Allow reading messages if the user is a participant. 
        // For queries (list), the rules check the parent conversation document.
        allow read: if isSignedIn() && (
          (request.auth.uid in conversationId.split('_')) ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && 
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids)
        );
        
        // Allow creating messages if the user is the sender and a participant.
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && (
          (request.auth.uid in conversationId.split('_')) ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) && 
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids)
        );
      }
    }
  }
}
