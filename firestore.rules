
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Comprehensive check for conversation membership
    // This function is designed to handle both deterministic IDs (uid1_uid2) 
    // and legacy random IDs by checking the participantUids array.
    function isMember(convoId, convoData) {
      return isSignedIn() && (
        (request.auth.uid in convoId.split('_')) || 
        (convoData != null && request.auth.uid in convoData.participantUids)
      );
    }

    // Users can read any profile, but only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings are public to read, but only owners can create/update.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // Conversations logic
    match /conversations/{conversationId} {
      // Allow creation if the user is a participant (either by ID or by field)
      allow create: if isSignedIn() && (
        request.auth.uid in conversationId.split('_') ||
        (request.resource.data.participantUids != null && request.auth.uid in request.resource.data.participantUids)
      );
      
      // Allow get (single doc) if member or in ID (to check existence before creation)
      allow get: if isSignedIn() && (
        (request.auth.uid in conversationId.split('_')) ||
        (resource != null && request.auth.uid in resource.data.participantUids) ||
        (exists(/databases/$(database)/documents/conversations/$(conversationId)) && 
         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids)
      );

      // Allow list (queries) if member of the document
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      // Allow update/delete if member
      allow update, delete: if isSignedIn() && (
        (request.auth.uid in conversationId.split('_')) ||
        (resource != null && request.auth.uid in resource.data.participantUids)
      );

      // Messages subcollection
      match /messages/{messageId} {
        // We use isMember but need to check the parent existence or use resource for existing
        allow read: if isSignedIn() && (
          (request.auth.uid in conversationId.split('_')) || 
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids != null && 
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids)
        );
        allow create: if isSignedIn() && (
          (request.auth.uid in conversationId.split('_') || 
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids) && 
          request.resource.data.senderId == request.auth.uid
        );
      }
    }
  }
}
