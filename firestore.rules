rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users can read any profile, but only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings are public to read, but only owners can create/update.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // Conversations logic
    match /conversations/{conversationId} {
      
      // Helper to check if the current user is a participant of this conversation
      function isMember(data) {
        return isSignedIn() && (
          // Allow if the conversation ID is the deterministic format (uid1_uid2) and user is part of it
          (request.auth.uid in conversationId.split('_')) || 
          // Or if the user is in the participantUids array
          (data != null && 
           data.participantUids != null && 
           request.auth.uid in data.participantUids)
        );
      }

      // Allow creation if the user is a participant
      allow create: if isSignedIn() && (
        request.auth.uid in conversationId.split('_') ||
        (request.resource.data.participantUids != null && request.auth.uid in request.resource.data.participantUids)
      );
      
      // Allow get (single doc) if member
      allow get: if isMember(resource.data) || 
                   (exists(/databases/$(database)/documents/conversations/$(conversationId)) && 
                    isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data));

      // Allow list (queries) if member of the document (filters on participantUids)
      allow list: if isSignedIn() && 
                    resource.data.participantUids != null && 
                    request.auth.uid in resource.data.participantUids;

      // Allow update/delete if member
      allow update, delete: if isMember(resource.data);

      // Messages subcollection
      match /messages/{messageId} {
        // Use get() on parent to verify membership for the messages subcollection
        allow read: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/conversations/$(conversationId)).data) && 
                       request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}