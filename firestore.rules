rules_version = '2';

// Last updated: 2024-05-22 10:45 AM (Force Sync)
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Users can read any profile, but only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings are public to read, but only owners can create/update.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // Conversations logic
    match /conversations/{conversationId} {
      
      // Robust member check that handles both deterministic IDs and legacy IDs
      function isMember() {
        return isSignedIn() && (
          // Check if UID is part of the ID string (deterministic format)
          (conversationId.indexOf(request.auth.uid) != -1) ||
          // Check if UID is in the participant array (if doc exists)
          (resource != null && 
           resource.data.participantUids != null && 
           request.auth.uid in resource.data.participantUids)
        );
      }

      // Allow get (single doc) if member or if the ID is a valid guess (deterministic)
      allow get: if isMember();

      // Allow list (queries) if member of the document (filters on participantUids)
      allow list: if isSignedIn() && 
                    resource.data.participantUids != null && 
                    request.auth.uid in resource.data.participantUids;

      // Allow creation if the user is a participant
      allow create: if isSignedIn() && (
        (conversationId.indexOf(request.auth.uid) != -1) ||
        (request.resource.data.participantUids != null && request.auth.uid in request.resource.data.participantUids)
      );
      
      // Allow update/delete if member
      allow update, delete: if isMember();

      // Messages subcollection
      match /messages/{messageId} {
        // Safe check using the parent document data
        function isConvoMember() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId));
          return isSignedIn() && convo.data.participantUids != null && request.auth.uid in convo.data.participantUids;
        }
        
        allow read: if isConvoMember();
        allow create: if isConvoMember() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}