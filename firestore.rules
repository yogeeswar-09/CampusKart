
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile, but only write to their own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }

    // Listings can be read by anyone authenticated.
    // Only the seller can create, update, or delete their own listings.
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if request.auth.uid == resource.data.sellerId;
    }

    // Conversations can be read/updated by participants.
    // Creation is allowed if the user is a participant and the ID is correctly formed.
    match /conversations/{conversationId} {
      allow read, update: if request.auth.uid in resource.data.participantUids;
      allow create: if request.auth.uid in request.resource.data.participantUids &&
                     conversationId == [request.resource.data.participantUids[0], request.resource.data.participantUids[1]].sort().join('_');
    }

    // Messages can be read by conversation participants.
    // Message creation is allowed if the sender is the authenticated user AND they are a participant 
    // (verified by checking if their UID is in the conversationId string itself).
    // This avoids a race condition during the initial batch write of a new conversation + message.
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;
      
      allow create: if request.auth.uid == request.resource.data.senderId &&
                     (request.auth.uid in conversationId.split('_'));
    }
  }
}
