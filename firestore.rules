
rules_version = '2';

// Last Sync: 2024-05-25 11:30 AM (Fixing 'get denied' and membership checks)
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the current user is a participant based on ID or data
    function isMember(docId, data) {
      return isSignedIn() && (
        (docId.indexOf(request.auth.uid) > -1) || 
        (data != null && data.participantUids != null && request.auth.uid in data.participantUids)
      );
    }

    // Users can read any profile, but only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings are public to read, but only owners can create/update.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // Conversations logic
    match /conversations/{conversationId} {
      // Allow 'get' if the user is part of the ID or the data. 
      // This is crucial for checking existence before creation.
      allow get: if isMember(conversationId, resource.data);
      
      // Standard reads for existing members
      allow list: if isSignedIn() && resource.data.participantUids != null && request.auth.uid in resource.data.participantUids;

      // Allow creation if the user is in the new participant list
      allow create: if isSignedIn() && request.resource.data.participantUids != null && request.auth.uid in request.resource.data.participantUids;

      // Allow updates if the user is currently a member
      allow update: if isSignedIn() && resource.data.participantUids != null && request.auth.uid in resource.data.participantUids;
      
      allow delete: if isSignedIn() && resource.data.participantUids != null && request.auth.uid in resource.data.participantUids;

      // Messages subcollection
      match /messages/{messageId} {
        // Membership is determined by the parent conversation document
        function isConvoMember() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId));
          return isSignedIn() && convo != null && convo.data.participantUids != null && request.auth.uid in convo.data.participantUids;
        }
        
        allow read: if isConvoMember();
        allow create: if isConvoMember() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
