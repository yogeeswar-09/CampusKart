
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Comprehensive check for conversation membership
    // 1. Checks if the deterministic ID contains the user's UID (fast, works for new chats in batches)
    // 2. Checks if the document exists and the user is in the participantUids array (works for all chats)
    function isMember(convoId) {
      return isSignedIn() && (
        (request.auth.uid in convoId.split('_')) || 
        (exists(/databases/$(database)/documents/conversations/$(convoId)) && 
         request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participantUids)
      );
    }

    // Users can read any profile, but only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings are public to read, but only owners can create/update.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // Conversations logic
    match /conversations/{conversationId} {
      // Allow creation if the user is a participant (either by ID or by field)
      allow create: if isSignedIn() && (
        request.auth.uid in conversationId.split('_') ||
        (request.resource.data.participantUids != null && request.auth.uid in request.resource.data.participantUids)
      );
      
      // Allow read/update if the user is a participant
      allow read, update, delete: if isMember(conversationId);

      // Messages subcollection
      match /messages/{messageId} {
        // Parent membership check covers both read and create
        allow read: if isMember(conversationId);
        allow create: if isMember(conversationId) && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
