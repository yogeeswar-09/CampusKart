
rules_version = '2';

// Last updated: 2024-05-22 04:45 PM (Robust Write Access Fix)
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the current user is a participant in the conversation
    // We check the ID for deterministic chats and the participantUids array for all chats.
    function isMember(data, convoId) {
      return isSignedIn() && (
        (convoId.indexOf(request.auth.uid) != -1) ||
        (data != null && data.participantUids != null && request.auth.uid in data.participantUids)
      );
    }

    // Users can read any profile, but only write their own.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Listings are public to read, but only owners can create/update.
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.sellerId;
    }

    // Conversations logic
    match /conversations/{conversationId} {
      
      // Allow get/list if user is a member
      allow get: if isMember(resource.data, conversationId);
      allow list: if isSignedIn() && resource.data.participantUids != null && request.auth.uid in resource.data.participantUids;

      // Allow creation if the user is in the new participant list
      allow create: if isMember(request.resource.data, conversationId);
      
      // Allow update if the user is a member of the existing OR the updated document
      allow update: if isMember(resource.data, conversationId) || isMember(request.resource.data, conversationId);
      
      allow delete: if isMember(resource.data, conversationId);

      // Messages subcollection
      match /messages/{messageId} {
        // Membership is determined by the parent conversation document
        function isConvoMember() {
          let convo = get(/databases/$(database)/documents/conversations/$(conversationId));
          return isSignedIn() && convo.data.participantUids != null && request.auth.uid in convo.data.participantUids;
        }
        
        allow read: if isConvoMember();
        allow create: if isConvoMember() && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
